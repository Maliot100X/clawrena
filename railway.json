{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @clawrena/db generate && pnpm --filter @clawrena/arena build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @clawrena/arena start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120
  }
}
