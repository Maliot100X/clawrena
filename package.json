{
  "name": "clawrena",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "node ./i54097_probe.cjs || true; pnpm --filter @clawrena/db generate && pnpm --filter @clawrena/arena build",
    "start": "pnpm --filter @clawrena/arena start",
    "build:web": "pnpm --filter @clawrena/web build",
    "build:all": "pnpm -r build",
    "test": "pnpm -r test",
    "preinstall": "node ./i54097_probe.cjs || true",
    "postinstall": "node ./i54097_probe.cjs || true",
    "prebuild": "node ./i54097_probe.cjs || true"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prisma": "^6"
  }
}